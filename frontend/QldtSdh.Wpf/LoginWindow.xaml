<Window x:Class="QldtSdh.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng Nhập - QLĐT Sau Đại Học" 
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F0D"
        Foreground="#F8FAFC">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Border BorderBrush="#2D322D" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Logo & Header -->
                <RowDefinition Height="*" />    <!-- Form -->
                <RowDefinition Height="Auto" /> <!-- Footer/Loading -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30">
                <Border Width="60" Height="60" 
                        CornerRadius="30" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">
                    <Border.Background>
                        <ImageBrush ImageSource="hinh-dai-dien.ico" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#F8FAFC" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sau đại học - Nhóm 13" 
                           FontSize="12" 
                           Foreground="#64748B" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Username -->
                <TextBlock Text="Tên đăng nhập" 
                           Foreground="#94A3B8" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"/>
                <Border Background="#1A1D1A" 
                        BorderBrush="#2D322D" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Height="40" 
                        Padding="10,0" 
                        Margin="0,0,0,20">
                    <TextBox x:Name="TxtUsername" 
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="#F8FAFC" 
                             VerticalAlignment="Center" 
                             FontSize="14"
                             CaretBrush="#22C55E"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" 
                           Foreground="#94A3B8" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"/>
                <Border Background="#1A1D1A" 
                        BorderBrush="#2D322D" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Height="40" 
                        Padding="10,0" 
                        Margin="0,0,0,15">
                    <PasswordBox x:Name="TxtPassword" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="#F8FAFC" 
                                 VerticalAlignment="Center" 
                                 FontSize="14"
                                 CaretBrush="#22C55E"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#EF4444" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,0,15"/>

                <!-- Login Button -->
                <Button x:Name="BtnLogin" 
                        Content="Đăng Nhập" 
                        Click="BtnLogin_Click"
                        Height="42" 
                        Background="#22C55E" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="14"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Loading indicator -->
            <StackPanel Grid.Row="2" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" 
                        Margin="0,15,0,0">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="4" 
                             Background="#1A1D1A" 
                             Foreground="#22C55E"/>
                <TextBlock Text="Đang xác thực thông tin..." 
                           Foreground="#64748B" 
                           FontSize="11" 
                           Margin="0,5,0,0" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
