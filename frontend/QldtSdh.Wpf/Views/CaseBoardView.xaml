<UserControl x:Class="QldtSdh.Wpf.Views.CaseBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QldtSdh.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0B0F0D">

    <UserControl.Resources>
        <!-- Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Board Content -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Board DataGrid -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quản lý Sự vụ (Case Management)" Foreground="#F8FAFC" FontSize="28" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="Bảng quản lý quy trình hỗ trợ học viên sau đại học theo workflow 4 trạng thái" Foreground="#94A3B8" FontSize="14" />
                </StackPanel>

                <Button Content="+ Tạo Case hỗ trợ mới" 
                        Command="{Binding OpenCreateCaseDialogCommand}"
                        CommandParameter="{x:Null}"
                        Style="{StaticResource PrimaryButton}" 
                        Grid.Column="1" 
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Cases Grid -->
            <Border Grid.Row="1" 
                    Background="#1A1D1A" 
                    BorderBrush="#2D322D" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16">
                <DataGrid ItemsSource="{Binding Cases}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2D322D"
                          RowBackground="#1A1D1A"
                          AlternatingRowBackground="#0B0F0D"
                          Foreground="#E2E8F0"
                          FontSize="13"
                          RowHeight="40">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D1A" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#2D322D" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="10,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#22C55E" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Case" Binding="{Binding CaseCode}" Width="120" FontWeight="Bold" Foreground="#22C55E" />
                        <DataGridTextColumn Header="Học viên" Binding="{Binding StudentName}" Width="180" />
                        <DataGridTextColumn Header="Loại sự vụ" Binding="{Binding CaseType}" Width="110" />
                        <DataGridTextColumn Header="Tiêu đề yêu cầu" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Độ ưu tiên" Binding="{Binding Priority}" Width="110" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Cán bộ xử lý" Binding="{Binding Assignee, TargetNullValue='Chưa phân công'}" Width="150" />
                        
                        <!-- Status Column with specific colors in Binding or Trigger if needed, text is enough -->
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" FontWeight="Bold" />
                        
                        <DataGridTextColumn Header="Hạn xử lý" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='Không có'}" Width="120" />

                        <!-- Action Column -->
                        <DataGridTemplateColumn Header="Hành động" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Chi tiết" 
                                            Command="{Binding DataContext.LoadCaseDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableActionButton}" 
                                            HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- OVERLAY 1: Create Case Dialog -->
        <Grid Background="#B0000000" 
              Visibility="{Binding IsCreateCaseOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1A1D1A" 
                    BorderBrush="#2D322D" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Width="600" 
                    Height="Auto" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="30"
                    MaxWidth="650">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Tạo Case Hỗ Trợ Học Viên" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <Button Content="✕" 
                                Command="{Binding CloseDialogsCommand}"
                                Foreground="#94A3B8" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="18" 
                                HorizontalAlignment="Right" 
                                Cursor="Hand" />
                    </Grid>

                    <!-- Student Selector -->
                    <TextBlock Text="Chọn học viên" Style="{StaticResource ModernLabel}" />
                    <ComboBox ItemsSource="{Binding StudentsList}"
                              SelectedItem="{Binding SelectedStudent}"
                              DisplayMemberPath="FullName"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,16" />

                    <!-- Case Type & Priority -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Loại sự vụ" Style="{StaticResource ModernLabel}" />
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewCaseType}" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Học tập" IsSelected="True" />
                                <ComboBoxItem Content="Học phí" />
                                <ComboBoxItem Content="Luận văn" />
                                <ComboBoxItem Content="Khác" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Mức độ ưu tiên" Style="{StaticResource ModernLabel}" />
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewCasePriority}" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Medium" IsSelected="True" />
                                <ComboBoxItem Content="High" />
                                <ComboBoxItem Content="Critical" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="Tiêu đề yêu cầu" Style="{StaticResource ModernLabel}" />
                    <TextBox Text="{Binding NewCaseTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" />

                    <!-- Assignee & DueDate -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Cán bộ xử lý" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding NewCaseAssignee}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Hạn xử lý" Style="{StaticResource ModernLabel}" />
                            <DatePicker SelectedDate="{Binding NewCaseDueDate}" Height="38" Padding="10,0" BorderBrush="#2D322D" />
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Button Content="Hủy" 
                                Command="{Binding CloseDialogsCommand}" 
                                Style="{StaticResource SecondaryButton}" 
                                Grid.Column="0" 
                                Margin="0,0,8,0" />
                        <Button Content="Tạo mới" 
                                Command="{Binding CreateCaseCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                Grid.Column="1" 
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 2: Case Details Dialog -->
        <Grid Background="#B0000000" 
              Visibility="{Binding IsCaseDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#1A1D1A" 
                    BorderBrush="#2D322D" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Width="850" 
                    Height="Auto" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="30"
                    MaxWidth="900"
                    MaxHeight="680">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Content Columns -->
                        <RowDefinition Height="Auto" /> <!-- Footer actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">
                                <Run Text="Chi tiết sự vụ - " />
                                <Run Text="{Binding SelectedCase.CaseCode}" Foreground="#22C55E" />
                            </TextBlock>
                            <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0">
                                <Run Text="Học viên: " />
                                <Run Text="{Binding SelectedCase.StudentName}" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                <Run Text=" | Người phụ trách: " />
                                <Run Text="{Binding SelectedCase.Assignee, TargetNullValue='Chưa có'}" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            </TextBlock>
                        </StackPanel>
                        
                        <Button Content="✕" 
                                Command="{Binding CloseDialogsCommand}"
                                Foreground="#94A3B8" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="18" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Columns content -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" /> <!-- Left: Info & Workflow transitions -->
                            <ColumnDefinition Width="*" />   <!-- Right: Notes History -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: State controls -->
                        <Border Grid.Column="0" 
                                Background="#0B0F0D" 
                                BorderBrush="#2D322D" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Thông tin yêu cầu" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Tiêu đề:" Foreground="#64748B" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedCase.Title}" TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="13" Margin="70,0,0,0" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Loại sự vụ:" Foreground="#64748B" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedCase.CaseType}" Foreground="#E2E8F0" FontSize="13" Margin="70,0,0,0" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Trạng thái:" Foreground="#64748B" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedCase.Status}" Foreground="#22C55E" FontWeight="Bold" FontSize="13" Margin="70,0,0,0" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Hạn xử lý:" Foreground="#64748B" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedCase.DueDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='Không có'}" Foreground="#EF4444" FontWeight="SemiBold" FontSize="13" Margin="70,0,0,0" />
                                </Grid>

                                <Separator Background="#2D322D" Margin="0,0,0,16" />

                                <!-- Workflow transitions -->
                                <TextBlock Text="Cập nhật trạng thái (Workflow)" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                                
                                <StackPanel>
                                    <!-- Assign to self / Assign to User -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AssigneeInput" Text="Cán bộ A" Style="{StaticResource ModernTextBox}" Padding="8,6" FontSize="13" Height="34" />
                                        <Button Content="Gán xử lý" 
                                                Command="{Binding AssignHandlerCommand}" 
                                                CommandParameter="{Binding ElementName=AssigneeInput, Path=Text}"
                                                Style="{StaticResource PrimaryButton}" 
                                                Grid.Column="1" 
                                                Padding="12,0" 
                                                Height="34" 
                                                Margin="6,0,0,0" />
                                    </Grid>

                                    <!-- Transition buttons -->
                                    <Button Content="Bắt đầu xử lý (Processing)" 
                                            Command="{Binding TransitionStatusCommand}" 
                                            CommandParameter="Processing"
                                            Style="{StaticResource SecondaryButton}" 
                                            Margin="0,0,0,8" 
                                            Height="36" />

                                    <Button Content="Đóng sự vụ (Closed)" 
                                            Command="{Binding TransitionStatusCommand}" 
                                            CommandParameter="Closed"
                                            Style="{StaticResource DangerButton}" 
                                            Height="36" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right Panel: Notes history -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />    <!-- List of Notes -->
                                <RowDefinition Height="Auto" /> <!-- Add Note Form -->
                            </Grid.RowDefinitions>

                            <!-- Notes List -->
                            <Border Grid.Row="0" 
                                    Background="#0B0F0D" 
                                    BorderBrush="#2D322D" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedCaseDetail.Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2D322D" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding CreatedBy}" Foreground="#22C55E" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Content}" Foreground="#E2E8F0" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Add Note Form -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Text="{Binding NewNoteContent, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Tag="Nhập ghi chú xử lý..." 
                                         Padding="10,8" 
                                         FontSize="13" />
                                
                                <Button Content="Gửi" 
                                        Command="{Binding AddNoteCommand}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Grid.Column="1" 
                                        Padding="16,0" 
                                        Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Footer Close button -->
                    <Button Content="Đóng lại" 
                            Command="{Binding CloseDialogsCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Grid.Row="2" 
                            HorizontalAlignment="Right" 
                            Width="100" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
