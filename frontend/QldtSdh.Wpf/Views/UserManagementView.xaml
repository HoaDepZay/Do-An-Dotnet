<UserControl x:Class="QldtSdh.Wpf.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QldtSdh.Wpf.ViewModels"
             xmlns:converters="clr-namespace:QldtSdh.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0B0F0D">
    
    <UserControl.Resources>
        <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter" />
        <converters:StatusForegroundConverter x:Key="StatusForegroundConverter" />
        <converters:StatusTextConverter x:Key="StatusTextConverter" />
        <converters:ActionTextConverter x:Key="ActionTextConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:FeedbackColorConverter x:Key="FeedbackColorConverter" />
    </UserControl.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý người dùng" 
                           Foreground="#F8FAFC" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Margin="0,0,0,6"/>
                <TextBlock Text="Quản trị tài khoản cán bộ đào tạo và thiết lập phân quyền truy cập hệ thống" 
                           Foreground="#94A3B8" 
                           FontSize="14" />
            </StackPanel>
            <Button Grid.Column="1" 
                    Content="🔄  Tải lại dữ liệu" 
                    Command="{Binding LoadUsersCommand}" 
                    Style="{StaticResource SecondaryButton}" 
                    VerticalAlignment="Center" 
                    Padding="15,8" />
        </Grid>

        <!-- 2. Content Section -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" /> <!-- DataGrid -->
                <ColumnDefinition Width="20" /> <!-- Spacer -->
                <ColumnDefinition Width="2*" /> <!-- Sidebar Action Forms -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel: User DataGrid -->
            <Border Grid.Column="0" 
                    Background="#1A1D1A" 
                    BorderBrush="#2D322D" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <!-- Table Title -->
                    <TextBlock Grid.Row="0" 
                               Text="Danh sách cán bộ" 
                               Foreground="#F8FAFC" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Margin="0,0,0,16"/>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Users}" 
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D322D"
                              RowBackground="Transparent" 
                              AlternatingRowBackground="#151715"
                              Foreground="#F8FAFC" 
                              RowHeaderWidth="0" 
                              CanUserAddRows="False"
                              IsReadOnly="True" 
                              FontSize="13" 
                              RowHeight="40">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#2D322D"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#262A26" />
                                        <Setter Property="Foreground" Value="#22C55E" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Username -->
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.2*" />
                            
                            <!-- FullName -->
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.8*" />
                            
                            <!-- RoleName -->
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" Width="1.5*" />

                            <!-- Email -->
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                            
                            <!-- IsActive Status -->
                            <DataGridTemplateColumn Header="Trạng thái" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                Background="{Binding IsActive, Converter={StaticResource StatusBackgroundConverter}}"
                                                BorderThickness="0">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource StatusTextConverter}}"
                                                       Foreground="{Binding IsActive, Converter={StaticResource StatusForegroundConverter}}"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Thao tác" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding IsActive, Converter={StaticResource ActionTextConverter}}"
                                                Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="8,2" FontSize="11" Height="24" Margin="0,0,5,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel: Add and Reset Forms -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Form 1: Add User -->
                    <Border Background="#1A1D1A" 
                            BorderBrush="#2D322D" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="➕  Tạo tài khoản cán bộ" 
                                       Foreground="#F8FAFC" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,16"/>
                            
                            <!-- Username -->
                            <TextBlock Text="Tên đăng nhập" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,0,12" />

                            <!-- Password -->
                            <TextBlock Text="Mật khẩu ban đầu" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,0,12" />

                            <!-- FullName -->
                            <TextBlock Text="Họ tên cán bộ" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,0,12" />

                            <!-- Email -->
                            <TextBlock Text="Email liên hệ" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,0,12" />

                            <!-- Role -->
                            <TextBlock Text="Vai trò phân quyền" Style="{StaticResource ModernLabel}" />
                            <ComboBox SelectedValuePath="Key" 
                                      DisplayMemberPath="Value"
                                      ItemsSource="{Binding RoleOptions}"
                                      SelectedValue="{Binding NewRoleId}" 
                                      Style="{StaticResource ModernComboBox}" 
                                      Margin="0,0,0,20" />

                            <!-- Create Button -->
                            <Button Content="Tạo tài khoản" 
                                    Command="{Binding CreateUserCommand}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    HorizontalAlignment="Stretch" 
                                    Height="38" />
                        </StackPanel>
                    </Border>

                    <!-- Form 2: Reset Password (Only visible if a user is selected) -->
                    <Border Background="#1A1D1A" 
                            BorderBrush="#2D322D" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="20"
                            Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🔑  Đặt lại mật khẩu" 
                                       Foreground="#F8FAFC" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,4"/>
                            
                            <TextBlock Text="{Binding SelectedUser.Username, StringFormat='Tài khoản: {0}'}" 
                                       Foreground="#94A3B8" 
                                       FontSize="13" 
                                       Margin="0,0,0,16" />

                            <TextBlock Text="Mật khẩu mới" Style="{StaticResource ModernLabel}" />
                            <TextBox Text="{Binding ResetPasswordValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Margin="0,0,0,16" />

                            <!-- Reset Button -->
                            <Button Content="Cập nhật mật khẩu" 
                                    Command="{Binding ResetPasswordCommand}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Background="#EAB308" 
                                    HorizontalAlignment="Stretch" 
                                    Height="38" />
                        </StackPanel>
                    </Border>

                    <!-- Feedback message card -->
                    <Border Background="#1E293B" 
                            BorderThickness="1"
                            BorderBrush="#334155"
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,15,0,0"
                            Visibility="{Binding FeedbackMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding FeedbackMessage}" 
                                   Foreground="{Binding IsSuccessFeedback, Converter={StaticResource FeedbackColorConverter}}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
