<UserControl x:Class="QldtSdh.Wpf.Views.GlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QldtSdh.Wpf.Views"
             xmlns:vm="clr-namespace:QldtSdh.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource ThemeBlackBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Search Panel -->
                <RowDefinition Height="*" />    <!-- Results Table -->
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tra cứu học viên toàn cục" 
                               Foreground="{DynamicResource TextWhiteBrush}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Tìm kiếm học viên, xem hồ sơ học tập, học phí, đề tài và văn bằng 360°" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Thêm học viên" 
                            Command="{Binding OpenCreateStudentDialogCommand}" 
                            Style="{StaticResource PrimaryButton}" 
                            Width="160" 
                            Margin="0,0,12,0" />
                    <Button Content="📂 Nhập từ CSV" 
                            Command="{Binding OpenImportCsvDialogCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Width="150" />
                </StackPanel>
            </Grid>

            <!-- 2. Search Panel -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource PanelDarkBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="20" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />     <!-- Keyword -->
                        <ColumnDefinition Width="220" />   <!-- Programme -->
                        <ColumnDefinition Width="150" />   <!-- Status -->
                        <ColumnDefinition Width="Auto" />  <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Keyword Search -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Từ khóa (Mã học viên, Tên học viên)" Style="{StaticResource ModernLabel}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- Programme Filter -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Chương trình đào tạo" Style="{StaticResource ModernLabel}" />
                        <ComboBox ItemsSource="{Binding Programmes}" 
                                  SelectedItem="{Binding SelectedProgramme}" 
                                  Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="Trạng thái học vụ" Style="{StaticResource ModernLabel}" />
                        <ComboBox ItemsSource="{Binding Statuses}" 
                                  SelectedItem="{Binding SelectedStatus}" 
                                  Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <!-- Actions Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Tìm kiếm" 
                                Command="{Binding SearchCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                Width="100" 
                                Margin="0,0,8,0" />
                        <Button Content="Reset" 
                                Command="{Binding ClearFiltersCommand}" 
                                Style="{StaticResource SecondaryButton}" 
                                Width="80" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Results Table Section -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource PanelDarkBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Margin="4,0,0,12">
                        <Run Text="Danh sách kết quả (" />
                        <Run Text="{Binding Students.Count, Mode=OneWay}" />
                        <Run Text=" học viên)" />
                    </TextBlock>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Students}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                              RowBackground="{DynamicResource PanelDarkBrush}"
                              AlternatingRowBackground="{DynamicResource ThemeBlackBrush}"
                              Foreground="{DynamicResource TextWhiteBrush}"
                              FontSize="13"
                              RowHeight="40"
                              VerticalScrollBarVisibility="Auto">
                        
                        <DataGrid.Resources>
                            <!-- Column Header style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource PanelDarkBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Height" Value="38" />
                            </Style>
                            <!-- Cell style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="10,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#22C55E" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Row Style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D322D" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <!-- Columns Definition -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã học viên" Binding="{Binding StudentCode}" Width="130" FontWeight="SemiBold" Foreground="#22C55E" />
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DOB, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                            <DataGridTextColumn Header="Chương trình học" Binding="{Binding ProgrammeName}" Width="250" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding CurrentStatus}" Width="120" />
                            
                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Hành động" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Hồ sơ 360°" 
                                                    Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TableActionButton}" 
                                                    Margin="0,0,6,0" />
                                            <Button Content="+ Tạo Case" 
                                                    Command="{Binding DataContext.CreateCaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#16A34A">
                                                <Button.Style>
                                                    <!-- Override hover background for Create Case button -->
                                                    <Style TargetType="Button" BasedOn="{StaticResource TableActionButton}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#22C55E" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- OVERLAY 1: Create Student Dialog -->
        <Grid Background="#B0000000" 
              Visibility="{Binding IsCreateStudentOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource PanelDarkBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Width="500" 
                    Height="Auto" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="30">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Thêm Học Viên Mới" Foreground="{DynamicResource TextWhiteBrush}" FontSize="20" FontWeight="Bold" />
                        <Button Content="✕" 
                                Command="{Binding CloseDialogsCommand}"
                                Foreground="{DynamicResource TextMutedBrush}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="18" 
                                HorizontalAlignment="Right" 
                                Cursor="Hand" />
                    </Grid>

                    <!-- Student Code -->
                    <TextBlock Text="Mã học viên" Style="{StaticResource ModernLabel}" />
                    <TextBox Text="{Binding NewStudentCode, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,16" />

                    <!-- Full Name -->
                    <TextBlock Text="Họ và tên" Style="{StaticResource ModernLabel}" />
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,16" />

                    <!-- DOB -->
                    <TextBlock Text="Ngày sinh" Style="{StaticResource ModernLabel}" />
                    <DatePicker SelectedDate="{Binding NewDOB}" 
                                Height="38" 
                                BorderBrush="{DynamicResource BorderDarkBrush}" 
                                Padding="10,0" 
                                Margin="0,0,0,16" />

                    <!-- Programme -->
                    <TextBlock Text="Chương trình đào tạo" Style="{StaticResource ModernLabel}" />
                    <ComboBox ItemsSource="{Binding NewProgrammes}"
                              SelectedItem="{Binding NewSelectedProgramme}"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,16" />

                    <!-- Status -->
                    <TextBlock Text="Trạng thái học vụ" Style="{StaticResource ModernLabel}" />
                    <ComboBox ItemsSource="{Binding NewStatuses}"
                              SelectedItem="{Binding NewSelectedStatus}"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,24" />

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" 
                                Command="{Binding CloseDialogsCommand}" 
                                Style="{StaticResource SecondaryButton}" 
                                Width="100" 
                                Margin="0,0,12,0" />
                        <Button Content="Lưu" 
                                Command="{Binding SaveStudentCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                Width="100" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 2: CSV Import Dialog -->
        <Grid Background="#B0000000" 
              Visibility="{Binding IsImportCsvOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource PanelDarkBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Width="750" 
                    Height="Auto" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="30"
                    MaxWidth="800">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Nhập Học Viên Từ Tệp CSV" Foreground="{DynamicResource TextWhiteBrush}" FontSize="20" FontWeight="Bold" />
                        <Button Content="✕" 
                                Command="{Binding CloseDialogsCommand}"
                                Foreground="{DynamicResource TextMutedBrush}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="18" 
                                HorizontalAlignment="Right" 
                                Cursor="Hand" />
                    </Grid>

                    <!-- File Picker -->
                    <TextBlock Text="Chọn tệp tin CSV" Style="{StaticResource ModernLabel}" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                 Text="{Binding CsvFilePath, Mode=OneWay}" 
                                 Style="{StaticResource ModernTextBox}" 
                                 IsReadOnly="True" 
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                Content="Duyệt file..." 
                                Command="{Binding SelectCsvFileCommand}" 
                                Style="{StaticResource SecondaryButton}" 
                                Margin="10,0,0,0" 
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Validation Summary -->
                    <Border Background="#1E293B" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding ValidationSummary}" 
                                   Foreground="{DynamicResource TextWhiteBrush}" 
                                   TextWrapping="Wrap" 
                                   FontSize="13" />
                    </Border>

                    <!-- DataGrid Preview -->
                    <TextBlock Text="Xem trước dữ liệu đọc được" Style="{StaticResource ModernLabel}" Margin="0,0,0,8" />
                    <Border BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Background="#111311" 
                            Padding="8"
                            Height="250"
                            Margin="0,0,0,24">
                        <DataGrid ItemsSource="{Binding ImportedStudents}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                                  RowBackground="Transparent"
                                  Foreground="{DynamicResource TextWhiteBrush}"
                                  FontSize="12"
                                  RowHeight="36"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="8,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã học viên" Binding="{Binding StudentCode}" Width="120" FontWeight="SemiBold" Foreground="#22C55E" />
                                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" />
                                <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DOB, StringFormat={}{0:dd/MM/yyyy}}" Width="100" />
                                <DataGridTextColumn Header="Chương trình học" Binding="{Binding ProgrammeName}" Width="180" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding CurrentStatus}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy" 
                                Command="{Binding CloseDialogsCommand}" 
                                Style="{StaticResource SecondaryButton}" 
                                Width="100" 
                                Margin="0,0,12,0" />
                        <Button Content="Xác nhận nhập" 
                                Command="{Binding ConfirmImportCsvCommand}" 
                                Style="{StaticResource PrimaryButton}" 
                                Width="150" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
