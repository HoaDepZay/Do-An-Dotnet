<UserControl x:Class="QldtSdh.Wpf.Views.GlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QldtSdh.Wpf.Views"
             xmlns:vm="clr-namespace:QldtSdh.Wpf.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0B0F0D">



    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Search Panel -->
            <RowDefinition Height="*" />    <!-- Results Table -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Tra cứu học viên toàn cục" 
                       Foreground="#F8FAFC" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,0,6"/>
            <TextBlock Text="Tìm kiếm học viên, xem hồ sơ học tập, học phí, đề tài và văn bằng 360°" 
                       Foreground="#94A3B8" 
                       FontSize="14" />
        </StackPanel>

        <!-- 2. Search Panel -->
        <Border Grid.Row="1" 
                Background="#1A1D1A" 
                BorderBrush="#2D322D" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- Keyword -->
                    <ColumnDefinition Width="220" />   <!-- Programme -->
                    <ColumnDefinition Width="150" />   <!-- Status -->
                    <ColumnDefinition Width="Auto" />  <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Keyword Search -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Từ khóa (Mã học viên, Tên học viên)" Style="{StaticResource ModernLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Programme Filter -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Chương trình đào tạo" Style="{StaticResource ModernLabel}" />
                    <ComboBox ItemsSource="{Binding Programmes}" 
                              SelectedItem="{Binding SelectedProgramme}" 
                              Style="{StaticResource ModernComboBox}" />
                </StackPanel>

                <!-- Status Filter -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Trạng thái học vụ" Style="{StaticResource ModernLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}" 
                              SelectedItem="{Binding SelectedStatus}" 
                              Style="{StaticResource ModernComboBox}" />
                </StackPanel>

                <!-- Actions Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Tìm kiếm" 
                            Command="{Binding SearchCommand}" 
                            Style="{StaticResource PrimaryButton}" 
                            Width="100" 
                            Margin="0,0,8,0" />
                    <Button Content="Reset" 
                            Command="{Binding ClearFiltersCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Width="80" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Results Table Section -->
        <Border Grid.Row="2" 
                Background="#1A1D1A" 
                BorderBrush="#2D322D" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Foreground="#94A3B8" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Margin="4,0,0,12">
                    <Run Text="Danh sách kết quả (" />
                    <Run Text="{Binding Students.Count, Mode=OneWay}" />
                    <Run Text=" học viên)" />
                </TextBlock>

                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Students}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2D322D"
                          RowBackground="#1A1D1A"
                          AlternatingRowBackground="#0B0F0D"
                          Foreground="#E2E8F0"
                          FontSize="13"
                          RowHeight="40"
                          VerticalScrollBarVisibility="Auto">
                    
                    <DataGrid.Resources>
                        <!-- Column Header style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1A1D1A" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#2D322D" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Height" Value="38" />
                        </Style>
                        <!-- Cell style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="10,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#22C55E" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- Row Style -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D322D" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <!-- Columns Definition -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã học viên" Binding="{Binding StudentCode}" Width="130" FontWeight="SemiBold" Foreground="#22C55E" />
                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" />
                        <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DOB, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
                        <DataGridTextColumn Header="Chương trình học" Binding="{Binding ProgrammeName}" Width="250" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding CurrentStatus}" Width="120" />
                        
                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Hành động" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Hồ sơ 360°" 
                                                Command="{Binding DataContext.ViewProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableActionButton}" 
                                                Margin="0,0,6,0" />
                                        <Button Content="+ Tạo Case" 
                                                Command="{Binding DataContext.CreateCaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#16A34A">
                                            <Button.Style>
                                                <!-- Override hover background for Create Case button -->
                                                <Style TargetType="Button" BasedOn="{StaticResource TableActionButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#22C55E" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
