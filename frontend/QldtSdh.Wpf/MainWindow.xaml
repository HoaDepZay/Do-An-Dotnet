<Window x:Class="QldtSdh.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QldtSdh.Wpf"
        xmlns:vm="clr-namespace:QldtSdh.Wpf.ViewModels"
        xmlns:views="clr-namespace:QldtSdh.Wpf.Views"
        mc:Ignorable="d"
        Title="Trung tâm điều hành và hồ sơ học viên 360° - QLĐT Sau đại học" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBlackBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:GlobalSearchViewModel}">
            <views:GlobalSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Student360ViewModel}">
            <views:Student360View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CaseBoardViewModel}">
            <views:CaseBoardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OperationsDashboardViewModel}">
            <views:OperationsDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SnapshotHistoryViewModel}">
            <views:SnapshotHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- 1. Sidebar Panel -->
        <Border Grid.Column="0" 
                Background="{DynamicResource PanelDarkBrush}" 
                BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />  <!-- Logo / Brand Title -->
                    <RowDefinition Height="*" />   <!-- Menu Items -->
                    <RowDefinition Height="Auto" /><!-- Footer User Info -->
                </Grid.RowDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="20,0">
                    <!-- Custom clean icon shape -->
                    <Border Width="36" Height="36" 
                            CornerRadius="18" 
                            Margin="0,0,12,0">
                        <Border.Background>
                            <ImageBrush ImageSource="hinh-dai-dien.ico" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ĐIỀU HÀNH 360°" 
                                   Foreground="{DynamicResource TextWhiteBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="15"/>
                        <TextBlock Text="Sau đại học - Nhóm 13" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Radio Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton Content="🔍   Tra Cứu Học Viên" 
                                 Command="{Binding NavigateToSearchCommand}"
                                 IsChecked="True"
                                 Style="{StaticResource NavButton}" />
                    
                    <RadioButton Content="📊   Dashboard Điều Hành" 
                                 Command="{Binding NavigateToDashboardCommand}"
                                 Style="{StaticResource NavButton}" />

                    <RadioButton Content="📋   Quản Lý Sự Vụ (Case)" 
                                 Command="{Binding NavigateToCasesCommand}"
                                 Style="{StaticResource NavButton}" />

                    <RadioButton Content="💾   Lịch Sử Snapshots" 
                                 Command="{Binding NavigateToSnapshotsCommand}"
                                 Style="{StaticResource NavButton}" />

                    <RadioButton Content="👤   Quản Lý Người Dùng" 
                                 Command="{Binding NavigateToUserManagementCommand}"
                                 Visibility="{Binding IsAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Style="{StaticResource NavButton}" />
                </StackPanel>

                <!-- Footer Theme Switcher & User Profile card -->
                <StackPanel Grid.Row="2" Margin="16" VerticalAlignment="Bottom">
                    <!-- Light/Dark Mode Switcher Button -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeToggleIcon}" Margin="0,0,8,0" FontSize="14" />
                            <TextBlock Text="{Binding ThemeToggleText}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- User Profile Card -->
                    <Border Background="{DynamicResource ThemeBlackBrush}" 
                            Padding="12" 
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Width="36" Height="36" 
                                    Background="#16A34A" 
                                    CornerRadius="18" 
                                    Margin="0,0,10,0">
                                <TextBlock Text="{Binding CurrentUserInitials}" 
                                           Foreground="White" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" />
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" 
                                           Foreground="{DynamicResource TextWhiteBrush}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentUserRole}" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           FontSize="11" />
                            </StackPanel>
                            
                            <!-- Logout Button -->
                            <Button Grid.Column="2" 
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="Đăng xuất khỏi hệ thống"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="5,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="5">
                                            <TextBlock Text="🚪" FontSize="16" Foreground="#EF4444" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Display Area -->
        <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
