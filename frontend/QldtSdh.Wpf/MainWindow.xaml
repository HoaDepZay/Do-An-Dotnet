<Window x:Class="QldtSdh.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QldtSdh.Wpf"
        xmlns:vm="clr-namespace:QldtSdh.Wpf.ViewModels"
        xmlns:views="clr-namespace:QldtSdh.Wpf.Views"
        mc:Ignorable="d"
        Title="Trung tâm điều hành và hồ sơ học viên 360° - QLĐT Sau đại học" 
        Height="768" Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F0D">

    <Window.Resources>
        <!-- Mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:GlobalSearchViewModel}">
            <views:GlobalSearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:Student360ViewModel}">
            <views:Student360View />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CaseBoardViewModel}">
            <views:CaseBoardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OperationsDashboardViewModel}">
            <views:OperationsDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SnapshotHistoryViewModel}">
            <views:SnapshotHistoryView />
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent"
                                BorderThickness="4,0,0,0"
                                Padding="16,0,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262A26" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#262A26" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#22C55E" />
                                <Setter Property="Foreground" Value="#22C55E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- 1. Sidebar Panel -->
        <Border Grid.Column="0" 
                Background="#1A1D1A" 
                BorderBrush="#2D322D" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />  <!-- Logo / Brand Title -->
                    <RowDefinition Height="*" />   <!-- Menu Items -->
                    <RowDefinition Height="Auto" /><!-- Footer User Info -->
                </Grid.RowDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="20,0">
                    <!-- Custom clean icon shape -->
                    <Border Width="36" Height="36" 
                            Background="#22C55E" 
                            CornerRadius="8" 
                            Margin="0,0,12,0">
                        <TextBlock Text="360" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ĐIỀU HÀNH 360°" 
                                   Foreground="#F8FAFC" 
                                   FontWeight="Bold" 
                                   FontSize="15"/>
                        <TextBlock Text="Sau đại học - Nhóm 13" 
                                   Foreground="#64748B" 
                                   FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Radio Menu -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton Content="🔍   Tra Cứu Học Viên" 
                                 Command="{Binding NavigateToSearchCommand}"
                                 IsChecked="True"
                                 Style="{StaticResource NavButton}" />
                    
                    <RadioButton Content="📊   Dashboard Điều Hành" 
                                 Command="{Binding NavigateToDashboardCommand}"
                                 Style="{StaticResource NavButton}" />

                    <RadioButton Content="📋   Quản Lý Sự Vụ (Case)" 
                                 Command="{Binding NavigateToCasesCommand}"
                                 Style="{StaticResource NavButton}" />

                    <RadioButton Content="💾   Lịch Sử Snapshots" 
                                 Command="{Binding NavigateToSnapshotsCommand}"
                                 Style="{StaticResource NavButton}" />
                </StackPanel>

                <!-- Footer User Profile card -->
                <Border Grid.Row="2" 
                        Background="#0B0F0D" 
                        Margin="16" 
                        Padding="12" 
                        CornerRadius="8"
                        BorderBrush="#2D322D"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Width="36" Height="36" 
                                Background="#16A34A" 
                                CornerRadius="18" 
                                Margin="0,0,10,0">
                            <TextBlock Text="AD" 
                                       Foreground="White" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" />
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Administrator" 
                                       Foreground="#F8FAFC" 
                                       FontWeight="SemiBold" 
                                       FontSize="13" />
                            <TextBlock Text="Cán bộ quản lý" 
                                       Foreground="#64748B" 
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Content Display Area -->
        <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
